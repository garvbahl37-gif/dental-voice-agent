# ─────────────────────────────────────────────────────────────────────────────
# Vaani — environment
#
# GEMINI_API_KEY is the only one that is required. The live path is Gemini Live
# native audio: speech in, speech out, one model. The key's project must be
# authorised for the Live API — a key that works for generateContent can still
# be refused for Live, and the error looks like a format problem when it is not.
#
# Everything below that line is optional and belongs to the earlier cascaded
# pipeline in packages/core + packages/providers, which is still tested but is
# not on the live path.
# ─────────────────────────────────────────────────────────────────────────────

# ── Required ─────────────────────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
# Must be a voice that carries both scripts convincingly.
GEMINI_LIVE_VOICE=Leda

# ── Runtime ──────────────────────────────────────────────────────────────────
VOICE_SERVER_PORT=8787
NEXT_PUBLIC_VOICE_SERVER_URL=ws://localhost:8787

# ── Access control ───────────────────────────────────────────────────────────
# /crm and /practice return patient names, mobile numbers and why someone rang a
# dentist. They fail closed: with nothing set here they answer loopback only,
# which covers local development and nothing else.
#
# Set a long random token to read them from off-box, and to open a call session
# from anywhere other than localhost:
VAANI_ADMIN_TOKEN=
# Comma-separated browser origins allowed to reach the server (CORS + WebSocket).
# e.g. https://console.yourpractice.in
VAANI_ALLOWED_ORIGINS=

# ─────────────────────────────────────────────────────────────────────────────
# Below: cascaded pipeline only. Not needed to run the product.
# ─────────────────────────────────────────────────────────────────────────────

# ── TTS ──────────────────────────────────────────────────────────────────────
# Premium voice + phrase-cache build. Without it: Piper (local).
ELEVENLABS_API_KEY=
# Voice ID must be a MULTILINGUAL voice — the same voice speaks Hindi and English,
# because a voice that changes identity mid-call destroys the illusion.
ELEVENLABS_VOICE_ID=hpp4J3VqNfWAUOO0d1Us   # Bella — 100% Hindi round-trip
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5

# ── LLM ──────────────────────────────────────────────────────────────────────
# Cloud reasoning + embeddings. Without it: Ollama qwen3:8b (local).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── STT ──────────────────────────────────────────────────────────────────────
# Groq whisper-large-v3-turbo is the fastest. Without a key: whisper.cpp (local).
DEEPGRAM_API_KEY=

# ── Telephony (Plan 5) ───────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── WhatsApp (Plan 5) ────────────────────────────────────────────────────────
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=

DATABASE_URL=file:./data/vaani.db

# Default tier per component: "local" | "cloud"
TIER_STT=local
TIER_LLM=local
TIER_TTS=local
