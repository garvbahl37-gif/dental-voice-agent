{
  "name": "vaani",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Vaani — AI front desk for dental practices. Multilingual (Hindi/English/Hinglish) voice agent.",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo build",
    "dev": "bash scripts/dev.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "turbo typecheck",
    "setup:models": "bash scripts/setup-local-models.sh",
    "build:phrases": "tsx scripts/build-phrase-cache.ts",
    "db:seed": "tsx scripts/seed-db.ts",
    "dev:turbo": "turbo dev"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "dotenv": "^16.4.7",
    "playwright": "^1.62.1",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "ws": "^8.18.0"
  },
  "dependencies": {
    "@google/genai": "^2.17.1",
    "kokoro-js": "^1.2.1"
  }
}
